    {
      "name": "GET /booking/:id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra status trước khi parse JSON",
              "pm.test(\"Status 200 – booking tồn tại\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Chỉ parse JSON khi status = 200",
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "",
              "    pm.test(\"firstname đúng\", function() {",
              "        pm.expect(res.firstname).to.eql(\"Nguyen\");",
              "    });",
              "    pm.test(\"lastname đúng\", function() {",
              "        pm.expect(res.lastname).to.eql(\"An\");",
              "    });",
              "    pm.test(\"totalprice đúng\", function() {",
              "        pm.expect(res.totalprice).to.eql(500);",
              "    });",
              "    pm.test(\"depositpaid đúng\", function() {",
              "        pm.expect(res.depositpaid).to.eql(true);",
              "    });",
              "    pm.test(\"checkin đúng\", function() {",
              "        pm.expect(res.bookingdates.checkin).to.eql(\"2025-01-01\");",
              "    });",
              "    pm.test(\"checkout đúng\", function() {",
              "        pm.expect(res.bookingdates.checkout).to.eql(\"2025-01-05\");",
              "    });",
              "    pm.test(\"additionalneeds đúng\", function() {",
              "        pm.expect(res.additionalneeds).to.eql(\"Breakfast\");",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
