    {
      "name": "POST /booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var res = pm.response.json();",
              "",
              "// ✅ Lưu vào environment variable",
              "pm.environment.set(\"bookingId\", res.bookingid);",
              "",
              "pm.test(\"Status 200\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Có bookingid là number\", function() {",
              "    pm.expect(res.bookingid).to.be.a(\"number\");",
              "});",
              "pm.test(\"firstname đúng kiểu string\", function() {",
              "    pm.expect(res.booking.firstname).to.be.a(\"string\").and.eql(\"Nguyen\");",
              "});",
              "pm.test(\"lastname đúng kiểu string\", function() {",
              "    pm.expect(res.booking.lastname).to.be.a(\"string\").and.eql(\"An\");",
              "});",
              "pm.test(\"totalprice đúng kiểu number\", function() {",
              "    pm.expect(res.booking.totalprice).to.be.a(\"number\").and.eql(500);",
              "});",
              "pm.test(\"depositpaid đúng kiểu boolean\", function() {",
              "    pm.expect(res.booking.depositpaid).to.be.a(\"boolean\").and.eql(true);",
              "});",
              "pm.test(\"checkin đúng format\", function() {",
              "    pm.expect(res.booking.bookingdates.checkin).to.eql(\"2025-01-01\");",
              "});",
              "pm.test(\"checkout đúng format\", function() {",
              "    pm.expect(res.booking.bookingdates.checkout).to.eql(\"2025-01-05\");",
              "});",
              "pm.test(\"additionalneeds đúng\", function() {",
              "    pm.expect(res.booking.additionalneeds).to.eql(\"Breakfast\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Nguyen\",\r\n  \"lastname\": \"An\",\r\n  \"totalprice\": 500,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2025-01-01\",\r\n    \"checkout\": \"2025-01-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
