          "script": {
            "type": "text/javascript",
            "exec": [
              "var res = pm.response.json();",
              "pm.environment.set(\"token\", res.token);",
              "",
              "pm.test(\"Status 200\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Có token trong response\", function() {",
