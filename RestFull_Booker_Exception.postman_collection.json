      "name": "EX-01 — POST /booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"⚠️ Server chấp nhận totalprice sai kiểu — trả về null\", function() {",
              "    pm.response.to.have.status(200);",
              "    var res = pm.response.json();",
              "    pm.expect(res.booking.totalprice).to.be.null;",
              "});",
              "",
              "pm.test(\"Kiểm tra kiểu dữ liệu totalprice trong response\", function() {",
              "    if (pm.response.code === 200) {",
              "        var res = pm.response.json();",
              "        console.log(\"⚠️ Server chấp nhận totalprice sai kiểu:\", res);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {}
      },
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Test\",\r\n  \"lastname\": \"Error\",\r\n  \"totalprice\": \"not_a_number\",\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2025-01-01\",\r\n    \"checkout\": \"2025-01-05\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
