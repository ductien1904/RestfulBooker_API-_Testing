  "item": [
    {
      "name": "POST /booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var res = pm.response.json();",
              "pm.collectionVariables.set(\"lifecycleBookingId\", res.bookingid);",
              "pm.environment.set(\"bookingId\", res.bookingid);",
              "",
              "pm.test(\"Tạo booking mới thành công\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"additionalneeds = Breakfast (dịch vụ đăng ký)\", function() {",
              "    pm.expect(res.booking.additionalneeds).to.eql(\"Breakfast\");",
              "});",
              "pm.test(\"depositpaid = false (chưa thanh toán)\", function() {",
              "    pm.expect(res.booking.depositpaid).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"totalprice\": 100,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2025-01-01\",\n    \"checkout\": \"2025-01-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
